<owl:NamedIndividual rdf:about="#Publication_49">
  <rdf:type rdf:resource="#Publication"/>
  <reportsReaction rdf:resource="#reaction_instance_49"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Publication_49</rdfs:label>
  <openalexId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W2371198616</openalexId>
  <score rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.9851041</score>
  <publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2005-01-01</publicationDate>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Title: Selective Catalytic Reduction Technology for Exhaust Gas Denitrification</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Selective catalytic reduction(SCR)technology is widely used in the removal of NO_x from exhaust gas.The paper describes the principle,technical process and operation affecting factors such as catalyst activity,reaction temperature,ammonia dosage and so on.Two application cases are also introduced.</rdfs:comment>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#reaction_instance_49">
  <rdf:type rdf:resource="#ReactionInstance"/>
  <instantiates rdf:resource="#reaction_selective_catalytic_reduction"/>

  <temperatureValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">300.0</temperatureValue>
  <temperatureUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">degC</temperatureUnit>
</owl:NamedIndividual>


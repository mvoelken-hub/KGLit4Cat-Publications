  <catalystType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">heterogeneous_catalysis</catalystType>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Publication_61">
  <rdf:type rdf:resource="#Publication"/>
  <reportsReaction rdf:resource="#reaction_instance_61"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Publication_61</rdfs:label>
  <openalexId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">W2299040644</openalexId>
  <score rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.98209965</score>
  <publicationDate rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1989-01-01</publicationDate>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Title: Kinetic mechanism of the water-gas-shift reaction over K/sub 2/CO/sub 3//carbon</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kinetic data of the alkali catalyzed WGS reaction can be described by a two step oxygen-exchange mechanism and an additional CO/sub 2/-chemisorption step. The Water-Gas-Shift reaction rate is dependent on both the partial pressure of the reducing and the oxidizing agent. In the presence of CO/sub 2/ in the gas phase reactivity is low, or decreases significantly if CO/sub 2/ is added to a CO, H/sub 2/O mixture.</rdfs:comment>
</owl:NamedIndividual>


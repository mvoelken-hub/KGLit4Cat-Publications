<owl:NamedIndividual rdf:about="#Publication_64">
  <rdf:type rdf:resource="#Publication"/>
  <reportsReaction rdf:resource="#reaction_instance_64"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Publication_64</rdfs:label>
